# Vorlage für .env.local (lokale Entwicklung). Diese Datei enthält keine echten Werte.
# Auf Vercel werden die Variablen unter Settings, Environment Variables gesetzt.
# Die Marketplace Integrationen (Neon, Upstash) tragen ihre Variablen selbst ein.
# Siehe docs/SETUP.md.

# --- Neon Postgres ---
# Gepoolte Adresse für den normalen Betrieb der App.
DATABASE_URL=
# Direkte Adresse ohne Pooler. Nur für Migrationen (npm run db:migrate).
DATABASE_URL_UNPOOLED=

# --- Upstash Redis ---
# REST Adresse und Token für alle normalen Befehle. Akzeptierte Namen:
#   UPSTASH_REDIS_REST_URL und UPSTASH_REDIS_REST_TOKEN
#   oder KV_REST_API_URL und KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP Adresse mit TLS (beginnt mit rediss://) für den Subscriber. Akzeptierte Namen: REDIS_URL oder KV_URL.
REDIS_URL=

# --- Adminportal (ab Meilenstein 2) ---
# Passwort für den Login, mindestens 8 Zeichen.
ADMIN_PASSWORD=
# Geheimnis zum Signieren der Session, mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
# Es gibt bewusst keinen Ersatzwert.
SESSION_SECRET=

# --- Optional ---
# Token, mit dem /api/health in der Produktion die Details zeigt (Header x-health-token).
HEALTH_TOKEN=
# Überschreibt das Präfix der Redis Schlüssel (Kleinbuchstaben und Ziffern, höchstens 16 Zeichen).
# Normalerweise nicht nötig: prod, preview, dev oder local werden automatisch gewählt.
APP_KEY_PREFIX=

# Nur für Messungen im Verbindungslabor: wann der Server eine Verbindung ankündigt und beendet (Millisekunden).
# Standard sind 270000 und 290000. Mit sehr hohen Werten (zum Beispiel 1000000) misst man die Grenze der Plattform selbst.
# Nicht für den Betrieb gedacht.
REALTIME_MAX_AGE_NOTICE_MS=
REALTIME_MAX_AGE_CLOSE_MS=

# --- Nur für Integrationstests ---
# Adresse einer eigenen Test Datenbank, damit die Tests des Quiz Repositorys laufen (sonst werden sie übersprungen).
# Für die Tests der Echtzeit Schicht zusätzlich TEST_REDIS_URL mit der Adresse eines eigenen Redis Servers (zum Beispiel redis://localhost:6379).
# Niemals die Datenbank von Produktion oder Preview eintragen, die Tests legen Daten an und löschen sie wieder.
TEST_DATABASE_URL=
TEST_REDIS_URL=
